# Copy to .env and adjust. None of these are required for LAN-only use.
POOLMATH_DB_PATH=/data/poolmath.db
TZ=America/New_York

# Optional: set to require a shared token (unset = open on your LAN).
# POOLMATH_AUTH_TOKEN=change-me

# Optional: receipt scanning with a local vision model (Ollama). Unset = off.
# POOLMATH_VLM_URL=http://192.168.123.81:11434
# POOLMATH_VLM_MODEL=llama3.2-vision

# Optional: Home Assistant MQTT publish (v1.1)
# MQTT_HOST=192.168.1.10
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_TOPIC_PREFIX=poolmath
